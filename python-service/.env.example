# Motor de base de datos: mysql (opción preferida) o sqlite (plan B).
DB_ENGINE=sqlite

# Variables para MySQL (solo si DB_ENGINE=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=monitores

# Ruta del archivo SQLite (solo si DB_ENGINE=sqlite)
DB_FILE=gestion_monitores.db

# Servicio
HOST=0.0.0.0
PORT=5000
